{
  "uid": "axolotl-overview",
  "title": "Axolotl - Server e container",
  "tags": ["axolotl"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Container attivi",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "count(container_memory_usage_bytes{name=~\"axolotl-.+\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] } },
    { "id": 2, "type": "stat", "title": "Uptime server",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "refId": "A", "expr": "time() - node_boot_time_seconds" } ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "id": 3, "type": "stat", "title": "RAM usata",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] } },
    { "id": 4, "type": "stat", "title": "Disco usato",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] } },
    { "id": 5, "type": "timeseries", "title": "Uso CPU del server",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "refId": "A", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU" } ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] } },
    { "id": 6, "type": "timeseries", "title": "Memoria per container",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "refId": "A", "expr": "container_memory_working_set_bytes{name=~\"axolotl-.+\"}", "legendFormat": "{{name}}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 7, "type": "timeseries", "title": "CPU per container",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [ { "refId": "A", "expr": "rate(container_cpu_usage_seconds_total{name=~\"axolotl-.+\"}[5m]) * 100", "legendFormat": "{{name}}" } ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] } },
    { "id": 8, "type": "timeseries", "title": "RAM del server",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Usata" },
        { "refId": "B", "expr": "node_memory_MemTotal_bytes", "legendFormat": "Totale" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] } },
    { "id": 9, "type": "timeseries", "title": "Disco usato nel tempo",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [ { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})", "legendFormat": "Disco" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] } },
    { "id": 10, "type": "table", "title": "Uptime per container",
      "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [ { "refId": "A", "expr": "time() - container_start_time_seconds{name=~\"axolotl-.+\"}", "instant": true, "format": "table" } ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["name", "Value"] } } },
        { "id": "organize", "options": { "renameByName": { "name": "Container", "Value": "Acceso da" } } }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } }
  ]
}
